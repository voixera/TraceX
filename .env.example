# TraceX Environment Variables

# Application
TRACEX_ENV=development
TRACEX_DEBUG=false
TRACEX_SECRET_KEY=change-me-to-a-random-secret-key-in-production

# Database (Supabase PostgreSQL supported via Transaction / Session Pooler)
# Standard: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracex
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis
REDIS_URL=redis://localhost:6379/0

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Web Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ADMIN_IDS=123456789,987654321

# Collector Configuration
COLLECTOR_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0

# Rate Limits
GITHUB_API_RATE_LIMIT=30
DNS_API_RATE_LIMIT=10
HTTP_API_RATE_LIMIT=60

# Third-party API Keys
GITHUB_TOKEN=your-github-personal-access-token
